# Copy to .env and fill in. Only the variables read by model.py are listed.

# NVIDIA API catalog key (used for gpt-oss-20b and the judge). OPENAI_API_KEY is accepted as a fallback name.
NVIDIA_API_KEY=

# Optional OpenAI-compatible proxy serving gpt-oss-20b (one member of LLM_POOL).
FREELLM_BASE_URL=http://localhost:3001/v1
FREELLM_API_KEY=

# Embeddings run locally through Ollama (`ollama serve`, `ollama pull nomic-embed-text`); no key needed.
